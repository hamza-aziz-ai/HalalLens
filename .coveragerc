# Backend coverage. CI runs `pipenv run pytest --cov` and fails below fail_under.
# fail_under is a ratchet: raise it when tests land, never lower it without the
# maintainer's review (docs/TESTING.md). `source` lists packages, so modules no
# test imports still count as 0% instead of disappearing from the total.
[run]
branch = True
source =
    api
    alerts
    crawler
    database
    etl
    jobs
    market_data
    narrator
    ratio_engine
omit =
    # Demo script, not shipped behaviour.
    ratio_engine/demo.py

[report]
fail_under = 47.2
# coverage compares the ROUNDED total with fail_under: at precision 0, 46.46%
# reads as 46 and fails a 46.4 floor.
precision = 2
skip_empty = True
show_missing = False
