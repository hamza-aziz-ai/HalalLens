# debug
{
  email {$ACME_EMAIL}
}

{$HALAL_API_DOMAIN} {
  @cors_origin {
    header Origin https://halallens.in https://www.halallens.in
  }
  @cors_preflight {
    method OPTIONS
    header Origin https://halallens.in https://www.halallens.in
  }
  handle @cors_preflight {
    header Access-Control-Allow-Origin "{http.request.header.Origin}"
    header Access-Control-Allow-Credentials "true"
    header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
    header Access-Control-Allow-Headers "Authorization,Content-Type"
    respond 204
  }
  header @cors_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
  header @cors_origin Access-Control-Allow-Credentials "true"
  header @cors_origin Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
  header @cors_origin Access-Control-Allow-Headers "Authorization,Content-Type"
  reverse_proxy api:8001
  encode zstd gzip
}

{$HALAL_APP_DOMAIN} {
  @policy_no_slash {
    path /terms /privacy /refund-policy /shipping-policy /contact
  }
  redir @policy_no_slash {path}/ 308
  reverse_proxy ui:3000
  encode zstd gzip
}
