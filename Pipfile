[[source]]
url = "https://pypi.org/simple"
# Must stay true: with verification disabled anyone able to intercept the
# install (CI runner, Docker build, developer laptop on a hostile network) can
# substitute package contents.
verify_ssl = true
name = "pip_conf_index_global"

[[source]]
url = "https://download.pytorch.org/whl/cu130"
verify_ssl = true
name = "downloadpytorch"

[packages]
firecrawl-py = "*"
psycopg2-binary = "*"
bs4 = "*"
requests = "*"
python-dotenv = "*"
cloudscraper = "*"
playwright = "*"
fake-useragent = "*"
lxml = "*"
minio = "*"
pandas = "*"
camelot-py = "*"
# Imported directly by etl/financial_data_processor.py. camelot-py no longer
# pulls it in transitively, so without this the API fails to import at startup.
pdfminer-six = "*"
ghostscript = "*"
uvicorn = "*"
fastapi = "*"
pytest = "*"
pandas-stubs = "*"
langchain = "*"
ollama = "*"
langchain-ollama = "*"
torch = {version = "*", index = "downloadpytorch"}

[dev-packages]
pytest = "*"

[requires]
python_version = "3.14"
python_full_version = "3.14.6"
