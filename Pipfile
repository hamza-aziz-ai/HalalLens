[[source]]
url = "https://pypi.org/simple"
# Must stay true: with verification disabled anyone able to intercept the
# install (CI runner, Docker build, developer laptop on a hostile network) can
# substitute package contents.
verify_ssl = true
name = "pip_conf_index_global"

[packages]
psycopg2-binary = "*"
requests = "*"
python-dotenv = "*"
cloudscraper = "*"
fake-useragent = "*"
lxml = "*"
minio = "*"
pandas = "*"
camelot-py = "*"
# Imported directly by etl/financial_data_processor.py. camelot-py no longer
# pulls it in transitively, so without this the API fails to import at startup.
pdfminer-six = "*"
uvicorn = "*"
fastapi = "*"

[dev-packages]
pytest = "*"
pandas-stubs = "*"
pytest-cov = "*"

# Minor version only: pinning a patch release (python_full_version) makes
# `pipenv install --deploy` abort as soon as python:3.14-slim moves on.
[requires]
python_version = "3.14"
