# HalalLens environment configuration
#
# Rebuilt from every variable the codebase reads (config/parameters.py,
# api/app.py, config/logging_config.py, monitoring/notifier.py, jobs/*,
# docker-compose*.yml, Caddyfile). Values shown are the in-code defaults;
# anything marked REQUIRED has no usable default.
#
# Committed template. Copy to .env and fill in the blanks.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Under docker compose this is the service name `postgres`; the compose files
# default it for you. Set it explicitly when pointing at an external database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Halal-Lens
POSTGRES_USER=halallens
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Filing PDF storage: any S3-compatible store (MinIO locally, Cloudflare R2 in
# production; MinIO no longer publishes free Docker images).
# R2: MINIO_HOST=<account-id>.r2.cloudflarestorage.com, MINIO_PORT=443,
# MINIO_SECURE=true, MINIO_REGION=auto, keys from an R2 API token with
# "Object Read & Write" on the bucket. Create the bucket in the dashboard.
# ---------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_REGION=
MINIO_BUCKET=bse-pdfs

# ---------------------------------------------------------------------------
# Indian Stock Market API (market caps, share prices, financial snapshots)
# ---------------------------------------------------------------------------
# REQUIRED - docker-compose-prod.yml refuses to start without these.
INDIAN_API_BASE_URL=
INDIAN_API_KEY=
# Hard cap on vendor requests per calendar month (UTC); 0 = none. The free plan
# allows 500, so production compose defaults to 450. Counted in
# INDIAN_API_QUOTA_FILE (persistent cache volume) across restarts.
INDIAN_API_MONTHLY_LIMIT=0
INDIAN_API_QUOTA_FILE=cache/indian_api_quota.json
# Relative gap at which an Indian API figure overrides an extracted one.
INDIAN_API_OVERRIDE_TOLERANCE=0.15

# ---------------------------------------------------------------------------
# Public URLs and CORS
# ---------------------------------------------------------------------------
# FRONTEND_BASE_URL also fixes the allowed Google post-login redirect origin.
# Production (docker-compose-prod.yml) derives it from HALAL_APP_DOMAIN.
FRONTEND_BASE_URL=http://localhost:3000
# Local/dev only. The production UI image calls /api on its own origin and
# Caddy routes /api/* to the API, so production ignores this.
NEXT_PUBLIC_HALAL_API_BASE_URL=http://localhost:8001
# Bare apex domain in production, e.g. halallens.in. When set, https://<domain>
# and https://www.<domain> are added to the CORS allowlist automatically.
HALAL_APP_DOMAIN=
# Extra origins, comma separated. Matched exactly.
ALLOWED_ORIGINS=
# Optional regex alternative. Matched with fullmatch - a prefix pattern would
# also accept https://your-app.com.attacker.test. Leave empty unless needed.
ALLOWED_ORIGIN_REGEX=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Session lifetime. 720h = 30 days.
AUTH_TOKEN_TTL_HOURS=720
# Comma-separated. These addresses are promoted to admin on sign-in and gain
# access to governance overrides, the feedback queue and the ops endpoints.
ADMIN_EMAILS=
# Signs the Google OAuth state parameter. Freshly generated below; rotating it
# only invalidates in-flight sign-in attempts.
OAUTH_STATE_SECRET=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-32

# Google SSO - optional. When any of these is blank, /auth/google/* returns 503
# and the dashboard hides the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://<HALAL_APP_DOMAIN>/api/auth/google/callback (register the
# same URL in the Google console).
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# ---------------------------------------------------------------------------
# Billing (Razorpay)
# ---------------------------------------------------------------------------
# When key id/secret are blank, /billing/razorpay/* returns 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate from the key secret - copy it from the Razorpay webhook settings.
# Webhook URL to register in production: https://<HALAL_APP_DOMAIN>/api/webhooks/razorpay
# Without it every webhook is rejected, which now also means paid users never
# get access when the browser-side verify call is lost.
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_PLAN_CODE=starter
SUBSCRIPTION_PRICE_INR=50
SUBSCRIPTION_INTERVAL_DAYS=30

# ---------------------------------------------------------------------------
# Rate limiting - counters are per worker process
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_METERED_PER_MINUTE=30
RATE_LIMIT_WRITE_PER_HOUR=30
# Believe X-Forwarded-For for rate-limit identity. Enable ONLY behind a proxy
# you control (the Caddy service); otherwise callers spoof it to reset limits.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Narrator / LLM - optional, falls back to the deterministic narrator
# ---------------------------------------------------------------------------
NARRATOR_MODE=rule_based
LLM_PROVIDER=vllm
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
# Set both to 0 to let the model/server decide (useful for reasoning models).
LLM_MAX_TOKENS=400
LLM_TIMEOUT=30
NARRATION_TIMEOUT_SECONDS=8.0
NARRATION_QUEUE_TIMEOUT_SECONDS=0.5
NARRATION_MAX_WORKERS=4
NARRATION_MAX_CONCURRENT=4

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
NARRATION_CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=60
RECENT_CACHE_TTL_SECONDS=30
# Per-cache entry ceiling; keys are symbol-derived, so this bounds memory.
CACHE_MAX_ENTRIES=2000

# ---------------------------------------------------------------------------
# Compliance-flip alert email - optional
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_SENDER=
ALERT_EMAIL_RECIPIENT=

# ---------------------------------------------------------------------------
# Ops alerting (scheduler failures) - optional, email and/or Slack
# ---------------------------------------------------------------------------
OPS_SMTP_HOST=
OPS_SMTP_PORT=587
OPS_SMTP_USERNAME=
OPS_SMTP_PASSWORD=
OPS_EMAIL_SENDER=
OPS_EMAIL_RECIPIENT=
OPS_SLACK_WEBHOOK=
MARKET_FAILURE_ALERT_THRESHOLD=3
OPS_EVENT_HISTORY=40

# ---------------------------------------------------------------------------
# Schedulers
# ---------------------------------------------------------------------------
INGESTION_INTERVAL_MINUTES=60
INGESTION_HEARTBEAT=/tmp/ingestion_heartbeat.txt
INGESTION_METRICS_PATH=logs/metrics/ingestion_metrics.jsonl
EVALUATION_INTERVAL_MINUTES=15
EVALUATION_BATCH_LIMIT=200
EVALUATION_LOOKBACK_DAYS=365
EVALUATION_HEARTBEAT=/tmp/evaluation_heartbeat.txt
EVALUATION_METRICS_PATH=logs/metrics/evaluation_metrics.jsonl

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_HTTP_REQUESTS=true
HALAL_LOG_ROOT=logs
HALAL_LOG_FALLBACK_ROOT=logs_runtime
LOG_BACKUP_COUNT=31

# ---------------------------------------------------------------------------
# Production deployment (docker-compose-prod.yml + Caddy) - REQUIRED there
# ---------------------------------------------------------------------------
# One worker: the watchlist store (cache/watchlists.json) and the rate limiter
# live in process memory/files, so more workers can lose watchlist updates and
# multiply rate limits. Raise only after watchlists move to Postgres.
API_WORKERS=1
# Email for Let's Encrypt (tls mode); required by compose in both modes.
ACME_EMAIL=
# How the site is exposed:
#   tls    (default) Caddy serves HALAL_APP_DOMAIN on ports 80/443 with
#          Let's Encrypt; DNS points at the host.
#   tunnel Cloudflare Tunnel: no open web ports, TLS at Cloudflare. Also set
#          COMPOSE_PROFILES=tunnel, CADDY_SITE_ADDRESS=:80,
#          CADDY_BIND=127.0.0.1 and CLOUDFLARE_TUNNEL_TOKEN, and route the
#          tunnel's public hostname to http://caddy:80.
CADDY_MODE=tls
# Defaults to HALAL_APP_DOMAIN; ":80" in tunnel mode.
CADDY_SITE_ADDRESS=
# Host address Caddy's ports bind to; 127.0.0.1 in tunnel mode.
CADDY_BIND=0.0.0.0
COMPOSE_PROFILES=
# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels (secret).
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL backups (backup service in docker-compose-prod.yml): pg_dump to
# MINIO_BUCKET under BACKUP_PREFIX, every BACKUP_INTERVAL_HOURS, pruned after
# BACKUP_RETENTION_DAYS.
BACKUP_PREFIX=backups/postgres/
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
