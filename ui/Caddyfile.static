# Static file server for the dashboard image (ui.Dockerfile). TLS, routing and
# /api live in the front Caddy (repository Caddyfile); this one only serves the
# Next.js static export on plain HTTP inside the compose network.
{
  admin off
  auto_https off
}

:3000 {
  root * /srv
  encode zstd gzip

  # Content-Security-Policy for the dashboard pages only (D-033); the API and
  # its Swagger page at /api/docs (jsDelivr assets) are served elsewhere.
  # Report-Only until the policy is proven in the browser console, then the
  # header name becomes Content-Security-Policy. 'unsafe-inline' scripts:
  # every page inlines a per-build RSC payload, so one static header cannot
  # list hashes, and a static export has no nonces. Razorpay hosts: the
  # checkout script and its api.razorpay.com iframe (no official list).
  # Cloudflare Web Analytics is on for the zone: Cloudflare injects its
  # beacon (static.cloudflareinsights.com) into HTML for browsers only, and it
  # reports to cloudflareinsights.com. Another Cloudflare feature that injects
  # scripts (Rocket Loader, email obfuscation) needs its host added here.
  header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.razorpay.com; font-src 'self' data:; connect-src 'self' https://*.razorpay.com https://cloudflareinsights.com; frame-src https://api.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  # trailingSlash export: /login/ -> login/index.html; file_server redirects
  # /login to /login/ and serves directory index files.
  file_server

  handle_errors {
    rewrite * /404.html
    file_server
  }

  log {
    output stdout
    format console
  }
}
